# ============================================================
# .env.example — Variables de entorno del backend
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env" (sin el .example)
# 2. Rellena cada variable con tus credenciales reales
# 3. NUNCA subas el archivo ".env" a GitHub (está en .gitignore)
# ============================================================

# === SERVIDOR ===
PORT=3000
NODE_ENV=development

# === BASE DE DATOS (Neon.tech) ===
# Cómo obtenerla: en neon.tech → tu proyecto → Connection String
# Asegúrate de que termine con ?sslmode=require
DATABASE_URL="postgresql://usuario:contraseña@host/nombre_db?sslmode=require"

# === JWT (JSON Web Token) ===
# JWT es el "ticket de acceso" que se le da al usuario al iniciar sesión.
# JWT_SECRET debe ser una cadena larga y aleatoria (mínimo 32 caracteres).
# Puedes generarla en: https://generate-secret.vercel.app/32
JWT_SECRET="cambia-esto-por-una-cadena-secreta-muy-larga"
JWT_EXPIRES_IN="7d"

# === CLOUDINARY (almacenamiento de imágenes de productos) ===
# Cómo obtenerlas: en cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

# === EMAIL (para enviar KUDE y confirmaciones al cliente) ===
# Para Gmail: usa una "Contraseña de aplicación" (no tu contraseña normal)
# Ver: myaccount.google.com → Seguridad → Contraseñas de aplicaciones
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="tu-email@gmail.com"
EMAIL_PASS="tu-contraseña-de-aplicacion"
EMAIL_FROM="\"Mi Tienda Bella\" <tu-email@gmail.com>"

# === WHATSAPP ===
# Número en formato internacional sin espacios ni guiones
WHATSAPP_NUMERO="+595981000000"
WHATSAPP_MENSAJE="Hola! Tengo una consulta sobre un producto..."

# === CORS (Seguridad de peticiones entre dominios) ===
# En desarrollo: http://localhost:5173
# En producción: la URL de tu frontend en Vercel
FRONTEND_URL="http://localhost:5173"

# === FACTURACIÓN ELECTRÓNICA e-Kuatia / SIFEN (Paraguay) ===
# NOTA: Estas credenciales las proporciona el proveedor intermediario
# que contrates (Sifende, FactPy, Neosystem, GuruSoft, etc.)
# El propietario del negocio debe gestionar estas credenciales con su proveedor.
FACTURACION_PROVEEDOR="simulacion"       # simulacion | sifende | factpy | neosystem
FACTURACION_API_URL="https://api.proveedor.com/v1"
FACTURACION_API_KEY="tu-api-key-del-proveedor"
FACTURACION_RUC="80012345-6"             # RUC de tu empresa
FACTURACION_TIMBRADO="12345678"          # Número de timbrado DNIT
FACTURACION_PUNTO_EXPEDICION_ONLINE="001"
FACTURACION_PUNTO_EXPEDICION_FISICO="002"
